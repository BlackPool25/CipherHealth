# =============================================================================
# Frontend Environment Variables
# =============================================================================
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Backend Environment Variables
# =============================================================================
# Storacha/Web3.Storage Configuration
STORACHA_API_URL=https://api.web3.storage
STORACHA_API_KEY=your_storacha_api_key_here

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEV_MODE=true

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database
DATABASE_URL=sqlite:///./decent_hospital.db

# =============================================================================
# Contracts / Deployer
# =============================================================================
SEPOLIA_RPC_URL=https://rpc.sepolia.org
DEPLOYER_PRIVATE_KEY=
HEALTH_RECORDS_CONTRACT_ADDRESS=

# =============================================================================
# Seed Script Configuration
# =============================================================================
INVITE_SEED_COUNT=10

# =============================================================================
# Hospital Registration & Invite Tokens
# =============================================================================
# MASTER_HOSPITAL_SECRET: Required for hospital registration.
# Generate a strong secret with: openssl rand -base64 32
# Hospitals must provide this secret in the X-MASTER-SECRET header during registration.
# IMPORTANT: Keep this secret secure and do not share it publicly.
MASTER_HOSPITAL_SECRET=

# INVITE_TOKEN_EXPIRY_SECONDS: Default expiry time for hospital-generated invite tokens.
# Default: 3600 (1 hour). Patients must use the token before it expires.
INVITE_TOKEN_EXPIRY_SECONDS=3600

# DEFAULT_GRANT_DURATION_SECONDS: Default duration for access grants.
DEFAULT_GRANT_DURATION_SECONDS=86400

