# Frontend Environment Variables
# ================================
# Copy this file to .env.local and fill in values
# cp .env.example .env.local

# Backend API Configuration
# -------------------------
# The URL where your backend FastAPI server is running
# Default: http://localhost:8000 for local development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Alternatively, use NEXT_PUBLIC_BACKEND_HOST for compatibility
# (Both are supported, NEXT_PUBLIC_API_URL takes precedence)
NEXT_PUBLIC_BACKEND_HOST=http://localhost:8000

# Blockchain Configuration
# ------------------------
# Sepolia Testnet RPC URL
# Get a free RPC from: https://infura.io, https://alchemy.com, or use public endpoint
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Smart Contract Address on Sepolia
# After deploying HealthRecords.sol, paste the contract address here
# Leave empty if not yet deployed
NEXT_PUBLIC_CONTRACT_ADDRESS=

# MetaMask Connection
# -------------------
# The app will automatically prompt for MetaMask connection when needed
# Make sure MetaMask is:
# 1. Installed in browser
# 2. Connected to Sepolia testnet (Chain ID: 11155111)
# 3. Has some Sepolia ETH for gas (get from https://sepoliafaucet.com)

# Storacha/IPFS Configuration  
# ---------------------------
# Gateway URL for fetching files (used by backend, configured in backend/.env)
# Frontend uses blob_url returned by backend API

