# Decent-Hospital Backend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# STORACHA (Web3.Storage) Configuration
# =============================================================================
# Storacha uses UCAN-based authentication via CLI.
# 1. Install CLI: npm install -g @storacha/cli
# 2. Login: storacha login <your-email>
# 3. Create space: storacha space create decent-hospital
# 4. For CI/backend: generate delegation proof (see docs below)
#
# Reference: https://docs.storacha.network/how-to/ci/

# OPTIONAL: Delegation proof for CI/backend (base64 encoded UCAN)
# Generate with: storacha delegation create <DID> --base64 \
#   -c space/blob/add -c space/index/add -c upload/add -c filecoin/offer
STORACHA_PROOF=

# Gateway URL for downloads (default: https://storacha.link)
STORACHA_GATEWAY_URL=https://storacha.link

# =============================================================================
# JWT Authentication
# =============================================================================
# Secret key for JWT token signing (use a strong random string in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# Ethereum/Sepolia Configuration
# =============================================================================
# Sepolia RPC URL - get from Infura, Alchemy, or use public RPC
# Infura: https://infura.io/
# Alchemy: https://www.alchemy.com/
# Public: https://rpc.sepolia.org (rate limited)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Contract address for HealthRecords (set after deployment)
# Deploy with: cd contracts && npx hardhat run scripts/deploy.ts --network sepolia
HEALTH_RECORDS_CONTRACT_ADDRESS=

# Private key for signing transactions (NEVER COMMIT THIS!)
# Must be funded with Sepolia ETH from: https://sepoliafaucet.com/
SIGNER_PRIVATE_KEY=

# =============================================================================
# Umbral Key Files
# =============================================================================
# Paths to key files (never store keys directly in env)
UMBRAL_SIGNING_KEY_FILE=./keys/signing_key.bin
UMBRAL_SECRET_KEY_FILE=./keys/secret_key.bin

# =============================================================================
# Application Configuration
# =============================================================================
# Development mode (enables seed-invite endpoint and debug features)
DEV_MODE=true

# Number of invite codes to seed (used by scripts/seed.py)
INVITE_SEED_COUNT=10

# Database path
DATABASE_URL=sqlite:///./decent_hospital.db

# Server configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
