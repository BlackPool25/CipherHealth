# Decent-Hospital Backend Environment Variables
# Copy this file to .env and fill in the values

# Web3.storage API token for IPFS pinning
# Get one at https://web3.storage
WEB3_STORAGE_TOKEN=your_web3_storage_token_here

# Ethereum/Web3 Configuration
ETH_RPC_URL=http://localhost:8545
ETH_PRIVATE_KEY=your_private_key_here
GRANT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Umbral Key Files (paths to key files, never store keys directly)
UMBRAL_SIGNING_KEY_FILE=./keys/signing_key.bin
UMBRAL_SECRET_KEY_FILE=./keys/secret_key.bin

# Development mode (enables seed-invite endpoint)
DEV_MODE=true

# Database path
DATABASE_URL=sqlite:///./decent_hospital.db
