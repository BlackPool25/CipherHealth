# Decent-Hospital Backend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# STORACHA (Web3.Storage) Configuration
# =============================================================================
# API URL for Storacha/web3.storage
STORACHA_API_URL=https://api.web3.storage
# API Key/Token from https://web3.storage
STORACHA_API_KEY=your_storacha_api_key_here

# Legacy variable (still supported for backwards compatibility)
WEB3_STORAGE_TOKEN=your_web3_storage_token_here

# =============================================================================
# JWT Authentication
# =============================================================================
# Secret key for JWT token signing (use a strong random string in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# Ethereum/Sepolia Configuration
# =============================================================================
# Sepolia RPC URL (Infura, Alchemy, or public RPC)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Contract address for HealthRecords (after deployment)
HEALTH_RECORDS_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Legacy variables
ETH_RPC_URL=https://rpc.sepolia.org
GRANT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# Umbral Key Files
# =============================================================================
# Paths to key files (never store keys directly in env)
UMBRAL_SIGNING_KEY_FILE=./keys/signing_key.bin
UMBRAL_SECRET_KEY_FILE=./keys/secret_key.bin

# =============================================================================
# Application Configuration
# =============================================================================
# Development mode (enables seed-invite endpoint and debug features)
DEV_MODE=true

# Number of invite codes to seed (used by scripts/seed.py)
INVITE_SEED_COUNT=10

# Database path
DATABASE_URL=sqlite:///./decent_hospital.db

# Server configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
